# ==============================================================================
# Environment Configuration Template for frontendoptimised2
# Copy this file to .env locally: cp .env.example .env
# ==============================================================================

# Gemini API Key (Required for AI generation pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (Optional for voice TTS generation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# GCP Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_ARTIFACTS_BUCKET=your-buddha3-artifacts-bucket
